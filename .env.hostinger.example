APP_NAME="NaskahCek"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://naskahcek.com
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ISI_DATABASE_HOSTINGER
DB_USERNAME=ISI_USERNAME_HOSTINGER
DB_PASSWORD=ISI_PASSWORD_HOSTINGER

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=file

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@slategray-penguin-737813.hostingersite.com"
MAIL_FROM_NAME="${APP_NAME}"

# Payment credentials: fill these only in Hostinger's .env, never commit them.
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
DOKU_API_KEY=
DOKU_IS_PRODUCTION=true
DOKU_CHECK_PRICE=10000
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=true
MIDTRANS_CHECK_PRICE=10000

# Queue settings
DB_QUEUE=default
DB_QUEUE_RETRY_AFTER=360

# Optional external tools. Leave empty if unavailable on shared hosting.
PYTHON_PATH=
WORD_COM_ENABLED=false
PDF_LIGHTWEIGHT=true
PDF_EXPORT_CACHE=true
NODE_PATH=
PDF_PAGE_MAX=50
