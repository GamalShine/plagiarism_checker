<IfModule mod_rewrite.c>
    Options -MultiViews -Indexes
    RewriteEngine On

    # Serve public assets when the project root is the document root.
    RewriteRule ^(build|css|images|templatejurnal|storage)(/.*)?$ public/$1$2 [L]
    RewriteRule ^(favicon\.ico|favicon\.svg|robots\.txt)$ public/$1 [L]

    # Never expose Laravel source files or server-side configuration.
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|vendor|tests|scripts|public)(/|$) - [F,L]
    RewriteRule ^(artisan|composer\.(json|lock)|package(-lock)?\.json|phpunit\.xml|vite\.config\.js|\.env)(/|$) - [F,L]

    # Send application routes to the root fallback entry point.
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>